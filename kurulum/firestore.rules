rules_version = '2';

// Bahri Taşdemir randevu sitesi – Firestore güvenlik kuralları.
// Firebase konsolunda: Firestore Database > Rules sekmesine yapıştırılır ve "Publish" denir.
service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici: yalnızca aşağıdaki kullanıcı kimlikleri.
    // Kimlik, Firebase > Authentication > Users tablosundaki "User UID" sütunundadır.
    // Birden fazla yönetici için: ['UID1', 'UID2']
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['mRnOUVTZdtSCpyg9GgM4NF26dhB3'];
    }

    function okDate(v) { return v is string && v.matches('20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]'); }
    function okTime(v) { return v is string && v.matches('[0-2][0-9]:00'); }
    function okText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Telefon yalnız rakamdır: Türkiye cep numarası başında 0 olmadan 10 hane, yurt dışı ülke koduyla en çok 15 hane.
    function okPhone(v) { return v is string && v.matches('[0-9]{10,15}'); }

    // Dolu saatler. Kişisel bilgi içermez; site boş saatleri göstermek için okur.
    // Belge adı şube_tarih_saat_personel olduğundan aynı kişiye aynı saatte ikinci kayıt açılamaz.
    match /dolu/{slotId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['branch', 'date', 'time', 'staff', 'rid'])
        && request.resource.data.keys().hasAll(['branch', 'date', 'time', 'staff', 'rid'])
        && request.resource.data.branch in ['club', 'luxury']
        && okDate(request.resource.data.date)
        && okTime(request.resource.data.time)
        && okText(request.resource.data.staff, 1, 60)
        && okText(request.resource.data.rid, 6, 40)
        && slotId == request.resource.data.branch + '_' + request.resource.data.date + '_' + request.resource.data.time + '_' + request.resource.data.staff
        // Aynı işlemde bu saate bağlı bir randevu da yazılıyor olmalı.
        && getAfter(/databases/$(database)/documents/randevular/$(request.resource.data.rid)).data.slot == slotId
      );
      allow delete: if isAdmin();
    }

    // Randevular. Telefon içerir; ad müşteri kaydında durur.
    // Herkes yalnızca yeni randevu ekleyebilir; okumak, değiştirmek ve silmek yöneticiye özeldir.
    match /randevular/{rid} {
      allow create: if
        request.resource.data.keys().hasOnly(['branch', 'gender', 'services', 'total', 'staff', 'anyStaff', 'date', 'time', 'phone', 'status', 'created', 'slot'])
        && request.resource.data.keys().hasAll(['branch', 'gender', 'services', 'total', 'staff', 'anyStaff', 'date', 'time', 'phone', 'status', 'created', 'slot'])
        && okText(rid, 6, 40)
        && request.resource.data.branch in ['club', 'luxury']
        && request.resource.data.gender in ['ERKEK', 'KADIN']
        && okText(request.resource.data.services, 1, 600)
        && okText(request.resource.data.total, 1, 80)
        && okText(request.resource.data.staff, 1, 60)
        && request.resource.data.anyStaff is bool
        && okDate(request.resource.data.date)
        && okTime(request.resource.data.time)
        && okPhone(request.resource.data.phone)
        && request.resource.data.status == 'yeni'
        && request.resource.data.created == request.time
        && okText(request.resource.data.slot, 10, 120)
        && request.resource.data.slot.matches(request.resource.data.branch + '_' + request.resource.data.date + '_' + request.resource.data.time + '_.{1,70}')
        // Aynı işlemde bu randevuya ait saat kilidi de yazılıyor olmalı.
        && getAfter(/databases/$(database)/documents/dolu/$(request.resource.data.slot)).data.rid == rid
        // Numara kayıtlı bir müşteriye ait olmalı: ya önceden kayıtlıdır ya da kaydı bu işlemde açılıyordur.
        && existsAfter(/databases/$(database)/documents/musteriler/$(request.resource.data.phone));
      allow read, update, delete: if isAdmin();
    }

    // Müşteri kayıtları: ad, yaş, cinsiyet. Belge adı telefon numarasıdır.
    // Kayıt yalnızca ilk randevuyla aynı işlemde açılabilir; sonradan değiştirilemez. Okumak yöneticiye özeldir.
    match /musteriler/{phone} {
      allow create: if
        okPhone(phone)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'age', 'gender', 'created', 'first'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'age', 'gender', 'created', 'first'])
        && request.resource.data.phone == phone
        && okText(request.resource.data.name, 3, 60)
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 110
        && request.resource.data.gender in ['K', 'E']
        && request.resource.data.created == request.time
        && okText(request.resource.data.first, 6, 40)
        // "first" bu işlemde açılan (önceden olmayan) ve aynı numaraya ait randevuyu göstermeli.
        && !exists(/databases/$(database)/documents/randevular/$(request.resource.data.first))
        && getAfter(/databases/$(database)/documents/randevular/$(request.resource.data.first)).data.phone == phone
        // "Kayıtlı" işareti de aynı işlemde yazılıyor (ya da önceden duruyor) olmalı.
        && existsAfter(/databases/$(database)/documents/kayitli/$(phone));
      allow read, update, delete: if isAdmin();
    }

    // Kayıtlı numaralar. Yalnızca "bu numara kayıtlı mı" sorusuna yanıt verir; içinde ad ya da başka bilgi yoktur.
    // Tek tek sorulabilir, toplu listelenemez. İşaret, müşteri kaydıyla aynı işlemde yazılır.
    match /kayitli/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.keys().hasAll(['v'])
        && request.resource.data.v == 1
        && !exists(/databases/$(database)/documents/musteriler/$(phone))
        && existsAfter(/databases/$(database)/documents/musteriler/$(phone));
      allow delete: if isAdmin();
    }
  }
}
